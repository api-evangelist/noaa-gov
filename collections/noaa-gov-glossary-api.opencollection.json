{
  "opencollection": "1.0.0",
  "info": {
    "name": "weather.gov Alerts Glossary API",
    "version": "3.9.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "User-Agent",
      "value": "{{User-Agent}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Glossary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "glossary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.weather.gov/glossary"
          },
          "docs": "Returns glossary terms"
        }
      ]
    }
  ],
  "bundled": true
}