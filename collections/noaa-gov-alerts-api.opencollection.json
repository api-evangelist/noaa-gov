        },
        {
          "info": {
            "name": "alerts_active",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.weather.gov/alerts/active",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Status (actual, exercise, system, test, draft)"
